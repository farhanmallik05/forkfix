# ==============================================================================
# Forkfix Environment Variables
# ==============================================================================

# Nebius Token Factory API Key (Required)
# Obtain from: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Project ID (for Contree Sandboxes)
NEBIUS_PROJECT_ID=your_project_id_here

# Tavily AI Search Key (Required for Escalation & Ground-Truth Research)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Sandbox Engine Configuration
# Options: 'contree' (Token Factory Sandboxes) | 'docker' (Local Docker fallback) | 'mock' (Fast UI dev)
SANDBOX_ENGINE=contree

# Target Repository Directory inside Sandbox
REPO_DIR=/testbed

# Server & Streaming Configuration
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
